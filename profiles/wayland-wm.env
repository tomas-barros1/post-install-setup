# ==============================================================================
# profiles/wayland-wm.env - Pacotes e Stacks Compartilhados para WMs Wayland
# ==============================================================================

# Pacotes Pacman compartilhados por todos os WMs Wayland (Hyprland, Noctalia, Sway)
WAYLAND_WM_PACMAN_PACKAGES=(
  # Portal e Integrações Wayland
  "xdg-desktop-portal"
  "foot"
  "greetd-regreet"
  "nwg-look"
  "wdisplays"
  "wlr-randr"
  "impala"
  "playerctl"
  "grim"
  "slurp"

  # Terminal padrão (implementa a Default Terminal Spec; respeita
  # ~/.config/xdg-terminals.list). Ficou no repo 'extra', não é mais AUR.
  "xdg-terminal-exec"

  # Input Method (Fcitx5)
  "fcitx5"
  "fcitx5-configtool"
  "fcitx5-gtk"
  "fcitx5-qt"
)

# Pacotes AUR compartilhados por todos os WMs Wayland
WAYLAND_WM_AUR_PACKAGES=(
  "helium-browser-bin"
  "qt5ct-kde"
  "qt6ct-kde"
  "polkit-gnome-git"
  "nautilus-open-any-terminal-git"
)

# Suíte Walker + Elephant (Launcher, Clipboard, Runner, etc.)
WALKER_AUR_PACKAGES=(
  "walker-bin"
  "elephant-bin"
  "elephant-clipboard-bin"
  "elephant-desktopapplications-bin"
  "elephant-providerlist-bin"
  "elephant-runner-bin"
  "elephant-archlinuxpkgs-bin"
  "elephant-calc-bin"
  "elephant-symbols-bin"
  "elephant-todo-bin"
  "elephant-websearch-bin"
)

# Barra e Notificações (Waybar + SwayNC + Wallpaper)
WAYBAR_SWAYNC_PACMAN_PACKAGES=(
  "swaybg"
  "flameshot"
  "swaync"
  "waybar"
)

WAYBAR_SWAYNC_AUR_PACKAGES=(
  "waybar-weather"
)
